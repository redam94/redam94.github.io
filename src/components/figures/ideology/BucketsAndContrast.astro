---
/**
 * The commentator's comparison and the model's answer on one axis (E118,
 * sections 3 and 5). Top: mean poll error of each dated bucket with one
 * standard deviation of single races either side. Bottom: centre minus left,
 * first as a difference in means with its bootstrap interval, then as the
 * full model's contrast with its 90% interval and two tail probabilities.
 * Every number is printed by the notebook; see data.ts for the cells.
 */
import Figure from "../Figure.astro";
import { f1, scale } from "../lib";
import { buckets, fullModel, naive, onBothLists, signed, tails } from "./data";

const xAt = scale(-8, 9, 196, 612);
const zeroX = f1(xAt(0));
const axisY = 300;

const bucketRows = buckets.map((bucket, i) => ({
  ...bucket,
  y: 66 + i * 38,
  x: f1(xAt(bucket.mean)),
  x0: f1(xAt(bucket.mean - bucket.sd)),
  x1: f1(xAt(bucket.mean + bucket.sd)),
  value: signed(bucket.mean, 2),
}));

const range = (lo: number, hi: number) => `${signed(lo)} to ${signed(hi)}`;

const naiveRow = {
  y: 216,
  x: f1(xAt(naive.mid)),
  x0: f1(xAt(naive.lo)),
  x1: f1(xAt(naive.hi)),
  text: `${signed(naive.mid, 2)} (${range(naive.lo, naive.hi)})`,
};

const modelRow = {
  y: 254,
  x: f1(xAt(fullModel.mid)),
  x0: f1(xAt(fullModel.lo)),
  x1: f1(xAt(fullModel.hi)),
  text: `${signed(fullModel.mid, 2)} (${range(fullModel.lo, fullModel.hi)})`,
};

const minusTwoX = f1(xAt(-2));
const plusTwoX = f1(xAt(2));
/** Both value labels start right of the wider interval, clear of the +2 mark. */
const valueX = f1(xAt(Math.max(naive.hi, fullModel.hi, 2)) + 10);
const ticks = [-8, -4, 0, 4, 8];
const total = buckets.reduce((sum, bucket) => sum + bucket.races, onBothLists);
---

<Figure
  frames={3}
  interval={3200}
  frameLabels={[
    "Dated buckets: the means lie within a point of each other",
    `The commentator's comparison: centre minus left is ${signed(naive.mid, 2)}`,
    `The full model: ${signed(fullModel.mid, 2)}, with zero well inside the interval`,
  ]}
  caption={`Poll error is the certified margin minus the final poll average, so a positive number means the Democrat beat the polls. The ${total} races are those of 2018 and 2022 with a poll in the last 21 days; the ${onBothLists} nominees on lists of both sides are not averaged. The grey lines in the top rows are one standard deviation of single races, not an interval for the mean. The lower rows are 90% intervals.`}
>
  <svg
    viewBox="0 0 640 346"
    role="img"
    aria-label={`Dot-and-interval chart in points of poll error. Mean poll error by dated bucket: ${bucketRows
      .map(
        row =>
          `${row.label.toLowerCase()}, ${row.races} nominees, ${row.value} with a standard deviation of ${row.sd}`
      )
      .join(
        "; "
      )}. Centre minus left as a difference in means: ${naiveRow.text}. Centre minus left in the full model: ${modelRow.text}. The model gives a probability of ${tails.centreAheadBy2} that centre-list nominees were ahead by 2 points or more and ${tails.leftAheadBy2} that left-list nominees were.`}
  >
    <text x="16" y="24" class="f-small f-text-muted">
      Dot: bucket mean. Grey line: one standard deviation of single races.
    </text>

    {
      ticks.map(tick => (
        <g>
          <line
            x1={xAt(tick)}
            x2={xAt(tick)}
            y1="40"
            y2={axisY}
            class={tick === 0 ? "f-axis" : "f-grid"}
          />
          <text
            x={xAt(tick)}
            y={axisY + 18}
            text-anchor="middle"
            class="f-small f-text-muted f-num"
          >
            {tick === 0 ? "0" : signed(tick, 0)}
          </text>
        </g>
      ))
    }
    <line x1={xAt(-8)} x2={xAt(9)} y1={axisY} y2={axisY} class="f-axis"></line>
    <text
      x={zeroX}
      y={axisY + 38}
      text-anchor="middle"
      class="f-small f-text-muted"
    >
      Points of poll error (right of 0: the Democrat beat the polls)
    </text>

    {
      bucketRows.map(row => (
        <g>
          <text x="16" y={row.y - 2} class="f-label">
            {row.label}
          </text>
          <text x="16" y={row.y + 14} class="f-small f-text-muted f-num">
            {row.races} nominees
          </text>
          <line
            x1={row.x0}
            x2={row.x1}
            y1={row.y}
            y2={row.y}
            class="f-muted f-thick"
          />
          <circle cx={row.x} cy={row.y} r="5" class="f-fill-line" />
          <text
            x={row.x}
            y={row.y - 10}
            text-anchor="middle"
            class="f-small f-label f-num"
          >
            {row.value}
          </text>
        </g>
      ))
    }

    <g data-from="1">
      <line x1="16" x2="612" y1="180" y2="180" class="f-grid"></line>
      <text x="16" y={naiveRow.y - 2} class="f-label">Centre minus left</text>
      <text x="16" y={naiveRow.y + 14} class="f-small f-text-muted">
        difference in means
      </text>
      <line
        x1={naiveRow.x0}
        x2={naiveRow.x1}
        y1={naiveRow.y}
        y2={naiveRow.y}
        class="f-line f-thick"></line>
      <circle cx={naiveRow.x} cy={naiveRow.y} r="5" class="f-line f-fill-bg"
      ></circle>
      <text x={valueX} y={naiveRow.y + 4} class="f-small f-label f-num">
        {naiveRow.text}
      </text>
    </g>

    <g data-from="2">
      <text x="16" y={modelRow.y - 2} class="f-label f-text-accent">
        Centre minus left
      </text>
      <text x="16" y={modelRow.y + 14} class="f-small f-text-muted">
        full model
      </text>
      <line
        x1={modelRow.x0}
        x2={modelRow.x1}
        y1={modelRow.y}
        y2={modelRow.y}
        class="f-accent f-thick"></line>
      <circle cx={modelRow.x} cy={modelRow.y} r="5.5" class="f-fill-accent"
      ></circle>
      <text
        x={valueX}
        y={modelRow.y + 4}
        class="f-small f-label f-num f-text-accent"
      >
        {modelRow.text}
      </text>
      <line
        x1={minusTwoX}
        x2={minusTwoX}
        y1={modelRow.y - 12}
        y2={modelRow.y + 18}
        class="f-line f-dash"></line>
      <line
        x1={plusTwoX}
        x2={plusTwoX}
        y1={modelRow.y - 12}
        y2={modelRow.y + 18}
        class="f-line f-dash"></line>
      <text
        x={minusTwoX - 8}
        y={modelRow.y + 32}
        text-anchor="end"
        class="f-small f-text-muted f-num"
      >
        left ahead by 2 or more: {tails.leftAheadBy2}
      </text>
      <text
        x={plusTwoX + 8}
        y={modelRow.y + 32}
        class="f-small f-text-muted f-num"
      >
        centre ahead by 2 or more: {tails.centreAheadBy2}
      </text>
    </g>
  </svg>
</Figure>
