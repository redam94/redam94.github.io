---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Datetime from "@/components/Datetime.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import { githubPages, githubPageUrl } from "@/data/githubPages";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
const rssPath = `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`;

// Long-form project sites that the posts draw on (see src/data/githubPages.ts).
const deeperRepos = [
  "pymc-challenges",
  "second-brain",
  "causal-vs-predictive-modeling",
  "double-ml-explainer",
];
const deeperSites = deeperRepos.flatMap(repo => {
  const page = githubPages.find(entry => entry.repo === repo);
  return page ? [page] : [];
});
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" data-home-path={homePath}>
    <section id="hero" class="on-dark bg-black">
      <div class="wide-layout py-20 text-center sm:py-28">
        <h1
          class="mx-auto max-w-[12em] text-[clamp(2.75rem,7.6vw,5.5rem)] leading-[1.05] tracking-[-0.03em] text-balance"
        >
          Thinking out loud about statistics.
        </h1>
        <p
          class="text-on-dark-muted mx-auto mt-6 max-w-[34em] text-lg text-balance sm:text-[1.3125rem] sm:leading-[1.4]"
        >
          I'm Matthew Reda. I write about Bayesian modeling, causal inference
          and marketing measurement: notes worth sharing, things I'm building,
          and the bad stats I see in the wild.
        </p>
        <p
          class="mt-8 flex flex-wrap items-center justify-center gap-x-7 gap-y-3 text-[17px]"
        >
          <a
            href={getRelativeLocaleUrl(locale, "posts")}
            class="btn-pill btn-pill-bright"
          >
            Read the posts
          </a>
          <a
            href="/portfolio/"
            data-astro-reload
            class="text-olive-bright hover:underline hover:underline-offset-4"
          >
            See the portfolio
          </a>
          <a
            href={rssPath}
            target="_blank"
            class="text-olive-bright hover:underline hover:underline-offset-4"
          >
            RSS feed
          </a>
        </p>
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section id="featured" class="bg-mist">
          <div class="wide-layout py-16 sm:py-24">
            <h2 class="text-3xl sm:text-5xl sm:leading-[1.08]">
              {t.home.featured}
            </h2>
            <ul class="mt-8 grid gap-5 sm:mt-12 md:grid-cols-2">
              {featuredPosts.map(({ id, data, filePath }) => (
                <li class="tile bg-card flex">
                  <a
                    href={getPostUrl(id, filePath, locale)}
                    class="group flex flex-1 flex-col p-7 sm:p-10"
                  >
                    <h3 class="group-hover:text-accent text-2xl leading-tight sm:text-[1.75rem]">
                      {data.title}
                    </h3>
                    <p class="text-muted-foreground mt-3 mb-6">
                      {data.description}
                    </p>
                    <Datetime
                      pubDatetime={data.pubDatetime}
                      modDatetime={data.modDatetime}
                      timezone={data.timezone}
                      class="mt-auto"
                    />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="bg-background">
          <div class="app-layout py-16 sm:py-24">
            <h2 class="text-3xl sm:text-5xl sm:leading-[1.08]">
              {t.home.recentPosts}
            </h2>
            <ul class="mt-4 sm:mt-6">
              {recentPosts.slice(0, postsConfig.perIndex).map(data => (
                <Card variant="h3" {...data} />
              ))}
            </ul>
            <p class="mt-8">
              <a href={getRelativeLocaleUrl(locale, "posts")} class="btn-pill">
                {t.home.allPosts}
                <IconArrowRight
                  class="inline-block size-5 rtl:-rotate-180"
                  aria-hidden="true"
                />
              </a>
            </p>
          </div>
        </section>
      )
    }

    {
      deeperSites.length > 0 && (
        <section id="go-deeper" class="bg-mist">
          <div class="wide-layout py-16 sm:py-24">
            <h2 class="text-3xl sm:text-5xl sm:leading-[1.08]">Go deeper</h2>
            <p class="text-muted-foreground mt-4 max-w-[36em] text-lg">
              The posts are the short version. These sites hold the worked
              examples, notes and interactive explainers behind them.
            </p>
            <ul class="mt-8 grid gap-5 sm:mt-12 md:grid-cols-2">
              {deeperSites.map(site => (
                <li class="tile on-dark flex bg-black">
                  <a
                    href={githubPageUrl(site)}
                    class="group flex flex-1 flex-col p-7 sm:p-10"
                  >
                    <h3 class="text-2xl leading-tight sm:text-[1.75rem]">
                      {site.title}
                    </h3>
                    <p class="text-on-dark-muted mt-3 mb-6">
                      {site.description}
                    </p>
                    <span class="text-olive-bright mt-auto group-hover:underline group-hover:underline-offset-4">
                      Open the site
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }
  </main>
  <Footer noMarginTop />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
